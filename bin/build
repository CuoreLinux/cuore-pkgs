#!/bin/bash
# Builds Cuore's packages in a throwaway Arch Linux container, signs them, and
# collects them into a signed pacman repository.
#
#   bin/build [--src <cuore checkout>] [--ref <commit or tag>] [--out <dir>] [--release | --unsigned] [package...]
#
# Packages build in dependency order (PACKAGES below) and each finished package
# is offered to the next ones through a local repository, so later packages
# can depend on earlier ones. cuore and cuore-settings build from a clean `git archive` of the
# given commit of a cuore checkout (default ../cuore, HEAD), so nothing
# uncommitted gets in. Nothing runs as root on the host: the container is
# rootless podman, and makepkg runs as an unprivileged user inside it.
#
# Three ways to sign (cuore D133, D134):
#   (default)   development builds for VM tests, signed with the development key
#               in dev/ (secret half in ~/.local/share/cuore-dev-signing, or
#               GNUPGHOME). Its own copies of Cuore's source and keyring get the
#               development key in place of the release key, so systems
#               installed from these builds trust what built them. Never published.
#   --release   CI's builds, signed with the release key named in the cuore
#               checkout's default/pacman/signing-key; GNUPGHOME must hold its
#               signing subkey.
#   --unsigned  CI's checks, without a key; nothing unsigned is published.
#
# Building and signing are two containers (cuore D190). The first runs every
# package's build code, fetched dependencies included, and never sees a key.
# The second holds the key, has no network, and runs nothing from a package: it
# signs the files the first one made and the repository's database. A build
# that was tampered with can spoil one release; it cannot take the key that
# every installed system trusts.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

PACKAGES=(
  limine-mkinitcpio-hook limine-snapper-sync xdg-terminal-exec yaru-icon-theme
  hyprland-preview-share-picker yay ufw-docker
  cuore-keyring cuore-settings cuore
  cutline jotter sprawl
)
IMAGE=docker.io/library/archlinux:base@sha256:f3691b4dde62ba4c4b6f0ae2c1fbf28e8c0c8c4b9a35c7e06dc1f70e21aa29f6

src=$(cd -- "$ROOT/../cuore" 2>/dev/null && pwd || true)
ref=HEAD
out="$ROOT/out"
selected=()
unsigned=0
release=0

while (($# > 0)); do
  case $1 in
    --src) src=$(cd -- "$2" && pwd); shift 2 ;;
    --ref) ref=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    --unsigned) unsigned=1; shift ;;
    --release) release=1; shift ;;
    -h | --help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) selected+=("$1"); shift ;;
  esac
done
((${#selected[@]} > 0)) || selected=("${PACKAGES[@]}")

for package in "${selected[@]}"; do
  [[ -f $ROOT/pkgbuilds/$package/PKGBUILD ]] || { echo "no PKGBUILD for $package" >&2; exit 2; }
done

[[ -n $src && -d $src/.git ]] || { echo "no cuore checkout at ${src:-../cuore}; pass --src" >&2; exit 2; }
((unsigned && release)) && { echo "--release and --unsigned don't go together" >&2; exit 2; }
key="" dev=0
if ((release)); then
  key=$(tr -d '[:space:]' <"$src/default/pacman/signing-key")
  gnupg=${GNUPGHOME:?--release needs GNUPGHOME with the release signing subkey}
elif ((!unsigned)); then
  dev=1
  key=$(tr -d '[:space:]' <"$ROOT/dev/signing-key")
  gnupg=${GNUPGHOME:-$HOME/.local/share/cuore-dev-signing}
fi
if [[ -n $key ]]; then
  [[ $key =~ ^[0-9A-F]{40}$ ]] || { echo "no full fingerprint for the signing key" >&2; exit 1; }
  gpg --homedir "$gnupg" --list-secret-keys "$key" >/dev/null 2>&1 ||
    { echo "the signing key $key isn't in $gnupg" >&2; exit 1; }
fi

work=$(mktemp -d)
trap 'rm -rf "$work"; rm -f "$out/.built"' EXIT
mkdir -p "$out" "$work/cuore-src"
git -C "$src" archive "$ref" | tar -x -C "$work/cuore-src"
cp -r "$ROOT/pkgbuilds" "$work/pkgbuilds"
if ((dev)); then
  # Development builds trust the development key, in their own copies only.
  cp "$ROOT/dev/signing-key" "$ROOT/dev/signing-key.asc" "$work/cuore-src/default/pacman/"
  cp "$ROOT/dev/cuore.gpg" "$ROOT/dev/cuore-trusted" "$work/pkgbuilds/cuore-keyring/"
fi
commit=$(git -C "$src" rev-parse "$ref")
# The version comes from the commit (bin/pkgver, cuore D160): a release or
# candidate tag names it, any other commit is <version>dev<commits>.
pkgver=$("$ROOT/bin/pkgver" "$src" "$ref")
tag=""
[[ $pkgver == *dev* ]] || tag="v${pkgver/rc/-rc}"
: >"$work/signing.key"
chmod 600 "$work/signing.key"
if ((unsigned)); then
  echo "Building ${#selected[@]} package(s) from cuore ${commit:0:12} ($pkgver), unsigned"
else
  gpg --homedir "$gnupg" --batch --export-secret-keys "$key" >"$work/signing.key"
  ((dev)) && kind="the development key" || kind="the release key"
  echo "Building ${#selected[@]} package(s) from cuore ${commit:0:12} ($pkgver), signing with $kind ${key: -16}"
fi

# The build container: no key, and no trace of one.
podman run --rm \
  -v "$work/pkgbuilds:/pkgbuilds:ro,z" \
  -v "$work/cuore-src:/cuore-src:ro,z" \
  -v "$ROOT/bin/check-names:/check-names:ro,z" \
  -v "$(cd -- "$out" && pwd):/out:z" \
  -e DEV="$dev" -e PACKAGES="${selected[*]}" -e PKGVER="$pkgver" -e TAG="$tag" -e COMMIT="$commit" \
  "$IMAGE" bash -euo pipefail -c '
    # Hand the output back to the invoking user (root here) whatever happens.
    trap "chown -R 0:0 /out" EXIT
    pacman -Syu --noconfirm --needed base-devel git sudo >/dev/null
    sed -i -E "/^OPTIONS=/s/([( ])debug/\1!debug/" /etc/makepkg.conf
    useradd -m builder
    echo "builder ALL=(ALL) NOPASSWD: /usr/bin/pacman" >/etc/sudoers.d/builder

    # Earlier packages in this run satisfy later ones, through a repository
    # that is this run only and unsigned until the signing container.
    printf "\n[cuore]\nSigLevel = Never\nServer = file:///out\n" >>/etc/pacman.conf
    chown -R builder /out
    rm -f /out/cuore.db*.sig /out/cuore.files*.sig /out/.built
    [[ -f /out/cuore.db.tar.gz ]] || sudo -u builder repo-add -q /out/cuore.db.tar.gz
    pacman -Sy >/dev/null

    for package in $PACKAGES; do
      echo "==> $package"
      rm -rf "/home/builder/$package"
      cp -r "/pkgbuilds/$package" "/home/builder/$package"
      chown -R builder "/home/builder/$package"
      cd "/home/builder/$package"
      env=()
      if [[ $package == cuore || $package == cuore-settings ]]; then
        env=(CUORE_SRC=/cuore-src)
        sed -i -e "s/^pkgver=.*/pkgver=$PKGVER/" -e "s/^_tag=.*/_tag=$TAG/" -e "s/^_commit=.*/_commit=$COMMIT/" PKGBUILD
        # cuore depends on cuore-settings=<pkgver>; keep the pair in step.
      fi
      checks=()
      # The keyring of a development build holds the development key, so its
      # checksums (made for the release key) are skipped.
      [[ $DEV == 1 && $package == cuore-keyring ]] && checks=(--skipchecksums)
      # Three lines of a good build, and enough of a failed one to see why.
      if ! sudo -u builder env "${env[@]}" PKGDEST=/out makepkg -s --noconfirm "${checks[@]}" >/tmp/makepkg.log 2>&1; then
        tail -n 60 /tmp/makepkg.log
        exit 1
      fi
      tail -n 3 /tmp/makepkg.log
      # Nothing Cuore ships names the desktop it was forked from (cuore D126):
      # a package that does is deleted before it reaches the repository.
      mapfile -t built < <(sudo -u builder env "${env[@]}" PKGDEST=/out makepkg --packagelist)
      /check-names "${built[@]}" || {
        for file in "${built[@]}"; do rm -f "$file" "$file.sig"; done
        exit 1
      }
      # -p: a package file left from an older build must not replace a newer one.
      for file in "${built[@]}"; do rm -f "$file.sig"; done
      printf "%s\n" "${built[@]}" >>/out/.built
      sudo -u builder repo-add -q -p /out/cuore.db.tar.gz /out/*.pkg.tar.zst
      pacman -Sy >/dev/null
    done
  '

# The signing container: the key, no network, and no package code. It signs
# what the build listed and adds it to the database again, which is what puts
# each signature in the database and signs the database itself.
if [[ -n $key ]]; then
  podman run --rm --network none \
    -v "$work/signing.key:/signing.key:ro,z" \
    -v "$(cd -- "$out" && pwd):/out:z" \
    -e KEY="$key" \
    "$IMAGE" bash -euo pipefail -c '
      export GNUPGHOME=/root/.gnupg
      install -d -m 700 "$GNUPGHOME"
      gpg --batch --quiet --import </signing.key
      mapfile -t built </out/.built
      ((${#built[@]} > 0)) || { echo "nothing was built to sign" >&2; exit 1; }
      for file in "${built[@]}"; do
        # Only package files in /out itself, and no link out of it.
        [[ $file == /out/*.pkg.tar.zst && ${file#/out/} != */* && -f $file && ! -L $file ]] ||
          { echo "refusing to sign $file" >&2; exit 1; }
        rm -f "$file.sig"
        gpg --batch --detach-sign --no-armor --local-user "$KEY" --output "$file.sig" "$file"
      done
      repo-add -q -p -s -k "$KEY" /out/cuore.db.tar.gz "${built[@]}"
    '
fi
rm -f "$out/.built"

echo "Done: $(cd -- "$out" && ls *.pkg.tar.zst | wc -l) package(s) in $out"
