#!/bin/bash
# Builds Cuore's packages in a throwaway Arch Linux container, signs them, and
# collects them into a signed pacman repository.
#
#   bin/build [--src <cuore checkout>] [--ref <commit>] [--out <dir>] [package...]
#
# Packages build in dependency order (PACKAGES below) and each finished package
# is offered to the next ones through a local repository, so later packages
# can depend on earlier ones. cuore and cuore-settings build from a clean `git archive` of the
# given commit of a cuore checkout (default ../cuore, HEAD), so nothing
# uncommitted gets in. Nothing runs as root on the host: the container is
# rootless podman, and makepkg runs as an unprivileged user inside it.
#
# Signing uses the key whose fingerprint is in the cuore checkout's
# default/pacman/signing-key, from GNUPGHOME (default:
# ~/.local/share/cuore-dev-signing). The key is copied into the container's
# memory for the run and never written to the output.

set -euo pipefail

ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)

PACKAGES=(
  limine-mkinitcpio-hook limine-snapper-sync xdg-terminal-exec yaru-icon-theme
  hyprland-preview-share-picker tensaku
  cuore-keyring cuore-settings cuore
)
IMAGE=docker.io/library/archlinux:base@sha256:f3691b4dde62ba4c4b6f0ae2c1fbf28e8c0c8c4b9a35c7e06dc1f70e21aa29f6

src=$(cd -- "$ROOT/../cuore" 2>/dev/null && pwd || true)
ref=HEAD
out="$ROOT/out"
selected=()

while (($# > 0)); do
  case $1 in
    --src) src=$(cd -- "$2" && pwd); shift 2 ;;
    --ref) ref=$2; shift 2 ;;
    --out) out=$2; shift 2 ;;
    -h | --help) sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) selected+=("$1"); shift ;;
  esac
done
((${#selected[@]} > 0)) || selected=("${PACKAGES[@]}")

for package in "${selected[@]}"; do
  [[ -f $ROOT/pkgbuilds/$package/PKGBUILD ]] || { echo "no PKGBUILD for $package" >&2; exit 2; }
done

[[ -n $src && -d $src/.git ]] || { echo "no cuore checkout at ${src:-../cuore}; pass --src" >&2; exit 2; }
key=$(tr -d '[:space:]' <"$src/default/pacman/signing-key")
[[ $key =~ ^[0-9A-F]{40}$ ]] || { echo "$src/default/pacman/signing-key holds no fingerprint" >&2; exit 1; }
gnupg=${GNUPGHOME:-$HOME/.local/share/cuore-dev-signing}
GNUPGHOME=$gnupg gpg --list-secret-keys "$key" >/dev/null 2>&1 ||
  { echo "the signing key $key isn't in $gnupg" >&2; exit 1; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$out" "$work/cuore-src"
git -C "$src" archive "$ref" | tar -x -C "$work/cuore-src"
commit=$(git -C "$src" rev-parse "$ref")
# Development builds get an increasing version that sorts before the release:
# 0.1.0dev<commits> < 0.1.0 (pacman orders an attached suffix as a pre-release).
devver="0.1.0dev$(git -C "$src" rev-list --count "$ref")"
GNUPGHOME=$gnupg gpg --batch --export-secret-keys "$key" >"$work/signing.key"
chmod 600 "$work/signing.key"

echo "Building ${#selected[@]} package(s) from cuore ${commit:0:12} ($devver), signing with ${key: -16}"

podman run --rm \
  -v "$ROOT/pkgbuilds:/pkgbuilds:ro,z" \
  -v "$work/cuore-src:/cuore-src:ro,z" \
  -v "$work/signing.key:/signing.key:ro,z" \
  -v "$(cd -- "$out" && pwd):/out:z" \
  -e KEY="$key" -e PACKAGES="${selected[*]}" -e DEVVER="$devver" -e COMMIT="$commit" \
  "$IMAGE" bash -euo pipefail -c '
    # Hand the output back to the invoking user (root here) whatever happens.
    trap "chown -R 0:0 /out" EXIT
    pacman -Syu --noconfirm --needed base-devel git sudo >/dev/null
    sed -i -E "/^OPTIONS=/s/([( ])debug/\1!debug/" /etc/makepkg.conf
    useradd -m builder
    echo "builder ALL=(ALL) NOPASSWD: /usr/bin/pacman" >/etc/sudoers.d/builder

    install -d -o builder -m 700 /home/builder/.gnupg
    sudo -u builder gpg --batch --quiet --import </signing.key
    pacman-key --init >/dev/null 2>&1
    sudo -u builder gpg --batch --export "$KEY" | pacman-key --add - >/dev/null
    pacman-key --lsign-key "$KEY" >/dev/null

    # Earlier packages in this run satisfy later ones.
    printf "\n[cuore]\nServer = file:///out\n" >>/etc/pacman.conf
    chown -R builder /out
    [[ -f /out/cuore.db.tar.gz ]] || sudo -u builder repo-add -q /out/cuore.db.tar.gz
    pacman -Sy >/dev/null

    for package in $PACKAGES; do
      echo "==> $package"
      rm -rf "/home/builder/$package"
      cp -r "/pkgbuilds/$package" "/home/builder/$package"
      chown -R builder "/home/builder/$package"
      cd "/home/builder/$package"
      env=()
      if [[ $package == cuore || $package == cuore-settings ]]; then
        env=(CUORE_SRC=/cuore-src)
        sed -i -e "s/^pkgver=.*/pkgver=$DEVVER/" -e "s/^_commit=.*/_commit=$COMMIT/" PKGBUILD
        # cuore depends on cuore-settings=<pkgver>; keep the pair in step.
      fi
      sudo -u builder env "${env[@]}" PKGDEST=/out makepkg -s --noconfirm --sign --key "$KEY" 2>&1 | tail -n 3
      # -p: a package file left from an older build must not replace a newer one.
      sudo -u builder repo-add -q -p -s -k "$KEY" /out/cuore.db.tar.gz /out/*.pkg.tar.zst
      pacman -Sy >/dev/null
    done
  '

echo "Done: $(cd -- "$out" && ls *.pkg.tar.zst | wc -l) package(s) in $out"
